.idea/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Scratch / working files (not part of the record)
scratch/
*.tmp

# --- Not redistributable: held locally, regenerated or requested on demand ---
# COSMIC Cancer Mutation Census derived counts. COSMIC's academic licence permits
# use but not redistribution. Regenerate with scripts/04_extract_cosmic_cmc.py from
# a licensed CMC download, or ask the author for the derived table.
data/interim/cosmic_cmc_hotspot_genes.tsv
# ... and every result table derived from it, plus the COSMIC workbook. Tables 15
# and 16 stay public because script 06 writes them without COSMIC columns.
results/*cosmic*
results/12_o4_o7_correlation.tsv
results/13_points_impact_of_cap.tsv
results/14_per_change_o4_o7_points.tsv

# The SVIG-UK v1.1 guideline PDFs and their extracted text are ACGS documents and
# are not republished here. Download them from the ACGS best-practice guidelines
# page; the passages the analysis depends on are quoted verbatim, with page
# references, in docs/svig-uk_o4_o7_extracts.md.
docs/svig-uk/

# AACR Project GENIE. Access is under a data-use agreement that forbids
# redistribution, so nothing derived from the release is tracked: not the raw
# files, not the per-change counts, not the result tables (results/18-28) and
# not the GENIE workbook. scripts/09-10 regenerate all of them for anyone with
# GENIE access; the findings and the report quote summary figures only.
GENIE*.zip
*genie*.zip
data/external/
data/interim/genie_*
results/*genie*

# Parallel analyses (analyses/<release>/, see scripts/paths.py) follow the same rules
# as the main one: nothing derived from GENIE or COSMIC per variant is tracked.
analyses/*/interim/genie_*
analyses/*/interim/cosmic_*
analyses/*/results/*genie*
analyses/*/results/*cosmic*
analyses/*/results/12_o4_o7_correlation.tsv
analyses/*/results/13_points_impact_of_cap.tsv
analyses/*/results/14_per_change_o4_o7_points.tsv
